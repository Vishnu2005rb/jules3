generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id                    String           @id @default(cuid())
  name                  String
  formTemplateId        String?
  certificateTemplateId String?
  startDate             DateTime
  endDate               DateTime
  submissions           UserSubmission[]
}

model UserSubmission {
  id                String       @id @default(cuid())
  name              String
  email             String
  phone             String
  eventId           String
  event             Event        @relation(fields: [eventId], references: [id])
  reviewImageUrl    String?
  extractedText     String?
  reviewLink        String?
  verificationScore Int          @default(0)
  status            String       @default("pending") // pending, approved, rejected, hold
  socialLinks       Json?        // { linkedin?: string, instagram?: string }
  createdAt         DateTime     @default(now())
  certificate       Certificate?

  @@index([email])
}

model Certificate {
  id            String         @id @default(cuid())
  submissionId  String         @unique
  submission    UserSubmission @relation(fields: [submissionId], references: [id])
  certificateId String         @unique // unique public ID for verification
  fileUrl       String
  issuedAt      DateTime       @default(now())
}

model Admin {
  id       String @id @default(cuid())
  username String @unique
  password String
}
