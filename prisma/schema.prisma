generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id                    String               @id @default(cuid())
  name                  String
  eventCode             String               @unique
  formTemplateId        String?
  formTemplate          FormTemplate?        @relation(fields: [formTemplateId], references: [id])
  certificateTemplateId String?
  certificateTemplate   CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id])
  startDate             DateTime
  endDate               DateTime
  submissions           UserSubmission[]
}

model CertificateTemplate {
  id        String   @id @default(cuid())
  name      String
  config    Json     // { textX: number, textY: number, color: string, fontSize: number, etc }
  createdAt DateTime @default(now())
  events    Event[]
}

model FormTemplate {
  id           String   @id @default(cuid())
  name         String
  fields       Json     // [{ label: string, type: string, required: boolean, options?: string[] }]
  headerConfig Json?    // { logoCompany?: string, logoCollege?: string, collegeName?: string, companyName?: string, layout?: string }
  createdAt    DateTime @default(now())
  events       Event[]
}

model UserSubmission {
  id                String       @id @default(cuid())
  name              String
  email             String
  phone             String
  eventId           String
  event             Event        @relation(fields: [eventId], references: [id])
  reviewImageUrl    String?
  imageHash         String?
  extractedText     String?
  reviewLink        String?
  verificationScore Int          @default(0)
  starRating        Int?         // Star rating detected by OCR (1-5), null if not detected
  status            String       @default("pending")
  socialLinks       Json?
  dynamicFields     Json?
  processingLog     Json?        // [{ step, message, level, timestamp, data? }]
  createdAt         DateTime     @default(now())
  certificate       Certificate?

  @@index([email])
  @@index([imageHash])
}

model Certificate {
  id            String         @id @default(cuid())
  submissionId  String         @unique
  submission    UserSubmission @relation(fields: [submissionId], references: [id])
  certificateId String         @unique // unique public ID for verification
  hash          String         @unique // Tamper-proof hash of certificate data
  fileUrl       String
  issuedAt      DateTime       @default(now())
}

model Admin {
  id       String @id @default(cuid())
  username String @unique
  password String
}
